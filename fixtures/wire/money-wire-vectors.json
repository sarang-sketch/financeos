{
  "$comment": [
    "The shared money wire vectors for Property 15 (task 29.4). Requirements 15.1, 15.8.",
    "",
    "ONE committed file, read by BOTH property suites:",
    "  test/property/money-wire.property.test.ts   (fast-check, TypeScript)",
    "  tests/property/test_money_wire.py           (Hypothesis, Python)",
    "",
    "Not two copies. design.md's Generators section is explicit about why: 'if each side",
    "generated independently, a boundary value that only one side happened to draw would",
    "produce a green suite on the other'. A vector added here is asserted twice; a vector",
    "removed from here fails both suites' coverage guards rather than quietly shrinking",
    "them.",
    "",
    "Every paise value is a STRING here, including inside `payloads`. A JSON number in",
    "this file would be parsed to an IEEE-754 double by both readers, and the vectors",
    "above 2^53 — the only ones that can catch a JSON-number implementation — would be",
    "corrupted by the fixture itself before either suite saw them.",
    "",
    "`malformed[].json` holds raw JSON TEXT rather than a parsed value, for the same",
    "reason: `a_json_number` and `a_json_float` have to reach each schema as the number",
    "the sender wrote, so each side parses the text with its own JSON parser and injects",
    "the result."
  ],
  "version": 1,
  "property": "P15",
  "validates": ["15.1", "15.8"],

  "seeds": {
    "$comment": "Committed, so any counterexample reproduces from the tests alone.",
    "fast_check_seed": 20260404,
    "fast_check_num_runs": 1000,
    "hypothesis_max_examples": 1000,
    "hypothesis_seed": 20260404
  },

  "range": {
    "min": "-99999999999999",
    "max": "99999999999999"
  },

  "boundary_constants": [
    "0",
    "1",
    "-1",
    "99",
    "100",
    "-99999999999999",
    "99999999999999"
  ],

  "in_range": [
    { "id": "zero", "paise": "0", "wire": "0" },
    { "id": "one_paisa", "paise": "1", "wire": "1" },
    { "id": "minus_one_paisa", "paise": "-1", "wire": "-1" },
    { "id": "ninety_nine_paise", "paise": "99", "wire": "99" },
    { "id": "one_rupee", "paise": "100", "wire": "100" },
    { "id": "range_floor", "paise": "-99999999999999", "wire": "-99999999999999" },
    { "id": "range_ceiling", "paise": "99999999999999", "wire": "99999999999999" },
    { "id": "one_inside_the_floor", "paise": "-99999999999998", "wire": "-99999999999998" },
    { "id": "one_inside_the_ceiling", "paise": "99999999999998", "wire": "99999999999998" },
    { "id": "set_9281_net", "paise": "84260000", "wire": "84260000" },
    { "id": "set_9281_net_negated", "paise": "-84260000", "wire": "-84260000" }
  ],

  "out_of_range": [
    { "id": "one_below_the_floor", "paise": "-100000000000000" },
    { "id": "one_above_the_ceiling", "paise": "100000000000000" },
    { "id": "two_pow_53", "paise": "9007199254740992" },
    { "id": "two_pow_53_negated", "paise": "-9007199254740992" },
    { "id": "unrounded_rate_product", "paise": "29999999999999700000" },
    { "id": "unrounded_rate_product_negated", "paise": "-29999999999999700000" }
  ],

  "above_two_pow_53": [
    {
      "id": "two_pow_53",
      "paise": "9007199254740992",
      "wire": "9007199254740992",
      "note": "The generator floor. Exactly representable as a double, so it passes on its own."
    },
    {
      "id": "two_pow_53_plus_one",
      "paise": "9007199254740993",
      "wire": "9007199254740993",
      "note": "The first integer a double cannot hold: JSON.parse yields 9007199254740992."
    },
    {
      "id": "unrounded_rate_product",
      "paise": "29999999999999700000",
      "wire": "29999999999999700000",
      "note": "PAISE_MAX * 300000 bp — the magnitude an unrounded applyRate product reaches."
    },
    {
      "id": "unrounded_rate_product_negated",
      "paise": "-29999999999999700000",
      "wire": "-29999999999999700000"
    },
    {
      "id": "ten_pow_20",
      "paise": "100000000000000000000",
      "wire": "100000000000000000000",
      "note": "The generator ceiling on both sides."
    },
    {
      "id": "ten_pow_20_negated",
      "paise": "-100000000000000000000",
      "wire": "-100000000000000000000"
    }
  ],

  "malformed": [
    {
      "id": "a_json_number",
      "json": "84260000",
      "why": "The mistake the whole contract exists to prevent. Coercion would launder it.",
      "accepted_when_nullable": false
    },
    {
      "id": "a_json_float",
      "json": "842600.5",
      "why": "Money is an integer number of paise; a fraction of a paisa is not money.",
      "accepted_when_nullable": false
    },
    {
      "id": "a_numeric_string_with_a_decimal_point",
      "json": "\"842600.00\"",
      "why": "Rupees where paise were expected, off by a factor of 100 and well formed.",
      "accepted_when_nullable": false
    },
    {
      "id": "a_numeric_string_with_leading_whitespace",
      "json": "\" 84260000\"",
      "why": "A trimming parser would accept it; the two runtimes must not disagree on trimming.",
      "accepted_when_nullable": false
    },
    {
      "id": "a_numeric_string_with_a_leading_plus_sign",
      "json": "\"+84260000\"",
      "why": "Number('+8') and int('+8') both accept it. The wire regex does not.",
      "accepted_when_nullable": false
    },
    {
      "id": "a_non_numeric_string",
      "json": "\"eighty-four lakh\"",
      "why": "The shape is right and the content is prose.",
      "accepted_when_nullable": false
    },
    {
      "id": "null",
      "json": "null",
      "why": "A stated absence. Legitimate only where the field is declared nullable.",
      "accepted_when_nullable": true
    },
    {
      "id": "a_nested_object",
      "json": "{\"value\": \"84260000\"}",
      "why": "A figure wrapped in an envelope. Rejected, not unwrapped.",
      "accepted_when_nullable": false
    }
  ],

