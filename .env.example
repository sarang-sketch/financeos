# FinanceOS — Environment Variables Template
# Copy this file to .env.local and fill in your credentials:
#   cp .env.example .env.local
#
# Or use the in-app Settings page (⚙️ Settings → API Keys & Credentials)
# to enter your keys via the UI.

# ============================================================
# Supabase Database Configuration (OPTIONAL)
# The app works fully without Supabase using in-memory seed data.
# For a live database, create a free project at https://supabase.com
# ============================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Razorpay Test Mode API Credentials (REQUIRED for payments)
# Get test-mode keys from: https://dashboard.razorpay.com/app/keys
# ============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ============================================================
# Google Gemini API Key (REQUIRED for AI features)
# Get yours from: https://aistudio.google.com/apikey
# ============================================================
GEMINI_API_KEY=

# ============================================================
# Optional: Additional AI Providers (not required)
# ============================================================
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ============================================================
# System Settings (leave as-is)
# ============================================================
CREDENTIAL_ENCRYPTION_KEY=9f8e7d6c5b4a3928170e9f8e7d6c5b4a3928170e9f8e7d6c5b4a3928170e9f8e
LOG_LEVEL=info
NODE_ENV=development
